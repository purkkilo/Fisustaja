NODE_ENV="<development|production>"
MONGODB_URI="<your_mongodb_uri>"
DB="<Your db name>"
DEV_DB="<Name of testing db> (if no second db, just leave empty and set testing to false)"
TESTING="<false|true>"
SECRET="<Your secret string for authentication>"
# Optional: set to 1 when running behind a reverse proxy (Heroku, Vercel, nginx)
TRUST_PROXY=""
# Optional: comma separated origins allowed to call the API from another site
CORS_ORIGINS=""
