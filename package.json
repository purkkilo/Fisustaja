{
  "name": "fisustaja-server",
  "author": "purkkilo",
  "license": "MIT",
  "version": "0.3.0",
  "description": "server for fisustaja",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "node --env-file=server/.env server/index.js",
    "server": "nodemon --env-file=server/.env server/index.js",
    "dev": "concurrently \" cd server && nodemon --env-file=.env index.js\" \"cd client && npm run serve\"",
    "build-app": "cd client && npm run build",
    "test": "npm run test:server && npm --prefix client test",
    "test:server": "node --test server/test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-history-api-fallback": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "~6.20.0",
    "mongoose": "^8.24.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7"
  }
}
